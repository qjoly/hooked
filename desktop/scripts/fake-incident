    updates: [
      {
        at: ago(12),
        author: { id: 'U-GRACE', name: 'Grace Hopper', type: 'user' },
        status: 'Investigating',
        severity: 'High',
        message: 'Rollback started, error rate is going down.',
      },
      {
        at: ago(36),
        author: { id: 'U-GRACE', name: 'Grace Hopper', type: 'user' },
        status: 'Investigating',
        severity: 'High',
      },
    ],
    workload: { total_minutes: 94.5, working_minutes: 94.5, late_minutes: 0, sleeping_minutes: 0 },
    investigation: {
      status: 'complete',
      summary: 'The rollout at 14:02 shipped an image that expects `PAYMENT_REGION`, which is unset.',
    },
  }),
  incident(408, 'Search latency above 2 s on eu-west', 'Fixing', 'Medium', 95, {
