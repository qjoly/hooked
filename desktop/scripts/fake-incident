    participants: ['Ada Lovelace', 'Alan Turing'],
    you: { participant: true },
  }),
  incident(407, 'RabbitMQ queue without consumers: invoices.dead-letter', 'Triage', null, 130, {
    team: null,
    summary: 'The invoices dead-letter queue has had no consumer for two hours.',
  }),
  incident(405, 'RabbitMQ queue without consumers: invoices.retry', 'Triage', null, 150, {
    summary: 'The invoices retry queue has had no consumer for two hours.',
  }),
  incident(404, 'Expired certificate on the staging ingress', 'Paused', 'Minor', 60 * 26, {
    summary: 'The wildcard certificate of staging expired. Paused until the renewal window.',
    roles: [lead('Alan Turing', 'U-ALAN')],
    participants: ['Alan Turing'],
  }),
  incident(401, 'Login errors for SSO tenants', 'Monitoring', 'Critical', 60 * 5, {
    team: 'TEAM-SEARCH',
    summary: 'SSO logins failed for 12 minutes after an identity provider change. A fix is deployed.',
    roles: [lead('Linus Torvalds', 'U-LINUS')],
    participants: ['Linus Torvalds', 'Grace Hopper', 'Alan Turing', 'Margaret Hamilton'],
  }),
  incident(398, 'Nightly export missed its window', 'Documenting', 'Medium', 60 * 30, {
    summary: 'The nightly export started four hours late.',
    roles: [lead('Ada Lovelace', 'U-ME')],
    participants: ['Ada Lovelace'],
    you: { participant: true },
  }),
  incident(395, 'Disk pressure on the logging nodes', 'Closed', 'Minor', 60 * 52, {
    summary: 'Three logging nodes ran out of disk. Retention was lowered.',
    roles: [lead('Margaret Hamilton', 'U-MARG')],
  }),
  incident(393, 'Disk almost full on logging-2', 'Merged', 'Minor', 60 * 53, {
    summary: 'Duplicate of the disk pressure incident.',
    merged_from: 'Triage',
    merged_into: { id: '01FAKE000395', external_id: 395, reference: 'INC-395', name: 'Disk pressure on the logging nodes', permalink: `${ORG}/incidents/395` },
  }),
  incident(390, 'False alarm on the status probe', 'Canceled', 'Minor', 60 * 80, {}),
];

let pinned = null;
const readonly = process.env.FAKE_INCIDENT_READONLY === '1';

const find = (ref) => {
  const key = String(ref || '').replace(/^INC-/i, '');
  return incidents.find((i) => i.id === ref || String(i.external_id) === key);
};
const you = (i) => ({ participant: !!i.you?.participant });
const listed = (i) => {
  const { participants, alerts, updates, workload, investigation, team, merged_from, slack_channel_deep_link, call_url, ...row } = i;
  const out = { ...row, you: you(i) };
  if (!out.severity) delete out.severity;
  if (!out.roles.length) delete out.roles;
  return out;
};
const shown = (i, include) => {
  const { merged_from, investigation, team, ...rest } = i;
  const owner = TEAMS.find((t) => t.id === team);
  const out = {
    ...rest,
    custom_fields: owner ? [{ field_id: 'CF-TEAM', name: 'Team', value: owner.name }] : [],
    ai_summary: i.summary,
    slack_channel_url: i.chat_channel_url,
    participant_count: i.participants.length,
    participants_truncated: false,
    open_action_count: 0,
    updates_total_count: i.updates.length,
    updates_truncated: false,
    timestamps: [{ name: 'Reported at', value: i.reported_at }],
    you: { ...you(i), name: ME.name, user_id: ME.id },
  };
  if (!out.severity) delete out.severity;
  if (include.includes('investigation')) out.investigation = investigation || { status: 'none' };
  return out;
};

const fail = (message, code = 'validation_error') => ({
  isError: true,
  content: [{ type: 'text', text: JSON.stringify({ type: code, errors: [{ code, message }] }) }],
  structuredContent: {},
});
const ok = (value) =>
  typeof value === 'string'
    ? { content: [{ type: 'text', text: value }] }
    : { content: [{ type: 'text', text: JSON.stringify(value) }], structuredContent: value };

const WRITES = new Set(['incident_merge', 'incident_unmerge', 'incident_update']);
const TOOLS = ['incident_list', 'incident_show', 'incident_merge', 'incident_unmerge', 'incident_update', 'incident_pin', 'identity_show'];

const tools = {
  identity_show: () => ({
    access_level: readonly ? 'read_only' : 'read_write',
    connection_type: 'oauth',
    organisation: { id: 'ORG', name: 'Acme' },
    user: { id: ME.id, name: ME.name },
  }),
  incident_list: (a) => {
    const cats = a.status_category || ['triage', 'active', 'paused', 'post-incident', 'closed'];
    const q = (a.query || '').toLowerCase();
    let rows = incidents.filter((i) => cats.includes(i.status.category));
    if (q) rows = incidents.filter((i) => i.name.toLowerCase().includes(q));
    const teams = a.team_part_of || a.team;
    if (teams) rows = rows.filter((i) => teams.includes(i.team));
    if (a.assigned_to) {
      const ids = a.assigned_to.map((u) => (u === 'me' ? ME.id : u));
      rows = rows.filter((i) => i.roles.some((r) => ids.includes(r.user_id)) || (ids.includes(ME.id) && i.you?.participant));
    }
    const size = Math.min(a.page_size || 10, 50);
    const start = a.after ? rows.findIndex((i) => i.id === a.after) + 1 : 0;
    const page = rows.slice(start, start + size);
    const more = start + size < rows.length;
    return {
      incidents: page.map(listed),
      pagination: { has_more: more, showing: page.length, total_count: rows.length, ...(more ? { next_cursor: page[page.length - 1].id } : {}) },
    };
  },
  incident_show: (a) => {
    const i = find(a.id);
    return i ? shown(i, a.include || []) : fail('incident not found', 'not_found');
  },
  incident_merge: (a) => {
    const target = find(a.merged_into_incident_id);
    if (!target) return fail('target incident not found', 'not_found');
    if (['merged', 'canceled'].includes(target.status.category)) return fail(`${target.reference} is ${target.status.category} and cannot be merged into`);
    const merged = [];
    const skipped = [];
    for (const ref of a.incident_ids || []) {
      const i = find(ref);
      if (!i) skipped.push({ reference: String(ref), reason: 'incident not found' });
      else if (i.id === target.id) skipped.push({ reference: i.reference, reason: 'an incident cannot be merged into itself' });
      else if (['merged', 'canceled'].includes(i.status.category)) skipped.push({ reference: i.reference, reason: `already ${i.status.category}` });
      else {
        i.merged_from = i.status.name;
        i.status = status('Merged');
        i.merged_into = { id: target.id, external_id: target.external_id, reference: target.reference, name: target.name, permalink: target.permalink };
        i.updated_at = ago(0);
        target.alerts.push(...i.alerts);
        merged.push({ reference: i.reference, name: i.name });
      }
    }
    if (!merged.length) return fail(`nothing could be merged: ${skipped.map((s) => `${s.reference} (${s.reason})`).join(', ')}`);
    return { merged_into: { reference: target.reference, name: target.name, permalink: target.permalink }, merged, skipped };
  },
  incident_unmerge: (a) => {
    const i = find(a.incident_id);
    if (!i) return fail('incident not found', 'not_found');
    if (i.status.category !== 'merged') return fail(`${i.reference} is not merged`);
    i.status = status(i.merged_from || 'Triage');
    delete i.merged_into;
    i.updated_at = ago(0);
    return { incident: listed(i) };
  },
  incident_update: (a) => {
    const i = find(a.incident_id);
    if (!i) return fail('incident not found', 'not_found');
    for (const ra of a.role_assignments || []) {
      const role = ROLES.find((r) => r.id === ra.role || r.name === ra.role);
      if (!role) return fail(`unknown role ${ra.role}`);
      i.roles = i.roles.filter((r) => r.role_id !== role.id);
      if (ra.user_id) {
        i.roles.push({ role: role.name, role_id: role.id, user: ra.user_id === ME.id ? ME.name : ra.user_id, user_id: ra.user_id });
        if (ra.user_id === ME.id) {
          i.you = { participant: true };
          if (!i.participants.includes(ME.name)) i.participants.push(ME.name);
        }
      }
    }
    i.updated_at = ago(0);
    return { incident: listed(i) };
  },
  incident_pin: (a) => {
    if (a.unset) {
      pinned = null;
      return 'Incident unpinned';
    }
    if (a.incident_id) {
      const i = find(a.incident_id);
      if (!i) return fail('incident not found', 'not_found');
      pinned = i.external_id;
      return `Pinned incident ${pinned}`;
    }
    return pinned ? `Active incident: ${pinned}` : 'No active incident';
  },
};

const CONFIG = `# Organisation configuration

## You

This is the user you are authenticated as.

- **Name:** ${ME.name}
- **Email:** ada@acme.example
- **User ID:** \`${ME.id}\`
- **Teams:**
  - Platform \`TEAM-PLATFORM\`
    - Schedule: Platform on-call \`SCHED-1\`

## Incident statuses

${STATUSES.map((s) => `- **${s.name}** [${s.category}] \`${s.id}\` — ${s.name}`).join('\n')}

## Severities

Higher rank = more severe.

${SEVERITIES.map((s) => `- **${s.name}** (rank ${s.rank}) \`${s.id}\` — ${s.name} impact.\nA second line of description.`).join('\n')}

## Incident roles

${ROLES.map((r) => `- **${r.name}** \`${r.id}\` — ${r.name}`).join('\n')}
`;

function handle(msg) {
  const p = msg.params || {};
  switch (msg.method) {
    case 'initialize':
      return { protocolVersion: p.protocolVersion, capabilities: { tools: {}, resources: {} }, serverInfo: { name: 'fake incident.io', version: '0' } };
    case 'tools/list':
      return { tools: TOOLS.map((name) => ({ name, description: name, inputSchema: { type: 'object' } })) };
    case 'resources/read':
      return { contents: [{ uri: p.uri, mimeType: 'text/markdown', text: CONFIG }] };
    case 'tools/call': {
      const args = p.arguments || {};
      if (process.env.FAKE_INCIDENT_LOG) fs.appendFileSync(process.env.FAKE_INCIDENT_LOG, `${JSON.stringify({ name: p.name, arguments: args })}\n`);
      if (!tools[p.name]) return fail(`unknown tool ${p.name}`);
      if (readonly && WRITES.has(p.name)) return fail('this connection is read-only', 'forbidden');
      const r = tools[p.name](args);
      return r && r.isError ? r : ok(r);
    }
    default:
      return undefined;
  }
}

readline.createInterface({ input: process.stdin }).on('line', (line) => {
  let msg;
  try {
    msg = JSON.parse(line);
  } catch {
    return;
  }
  if (msg.id === undefined) return;
  const result = handle(msg);
  const answer = result === undefined ? { error: { code: -32601, message: `unknown method ${msg.method}` } } : { result };
  process.stdout.write(`${JSON.stringify({ jsonrpc: '2.0', id: msg.id, ...answer })}\n`);
});
