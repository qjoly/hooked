#!/usr/bin/env node
// A stand-in for `incident mcp`, the incident.io desktop binary: the same MCP-over-stdio surface
// for the tools the Incidents page calls, on made-up incidents kept in memory. It is how the
// page is snapshotted and how merges are exercised without touching a real incident:
//
//   HOOKED_INCIDENT_BIN=scripts/fake-incident cargo run -- --snap /tmp/inc.png -- --page incidents
//
// FAKE_INCIDENT_READONLY=1 answers as a read-only connection; FAKE_INCIDENT_LOG=<file> appends
// every tool call to a file, one JSON object per line.

import fs from 'node:fs';
import readline from 'node:readline';

const ORG = 'https://app.incident.example/acme';
const ME = { id: 'U-ME', name: 'Ada Lovelace' };
const NOW = Date.now();
const ago = (min) => new Date(NOW - min * 60_000).toISOString().replace(/\.\d+Z$/, 'Z');

const SEVERITIES = [
  { id: 'SEV-MINOR', name: 'Minor', rank: 0 },
  { id: 'SEV-MEDIUM', name: 'Medium', rank: 1 },
  { id: 'SEV-HIGH', name: 'High', rank: 2 },
  { id: 'SEV-CRIT', name: 'Critical', rank: 3 },
];
const STATUSES = [
  { id: 'ST-TRIAGE', name: 'Triage', category: 'triage' },
  { id: 'ST-INV', name: 'Investigating', category: 'active' },
  { id: 'ST-FIX', name: 'Fixing', category: 'active' },
  { id: 'ST-MON', name: 'Monitoring', category: 'active' },
  { id: 'ST-PAUSED', name: 'Paused', category: 'paused' },
  { id: 'ST-DOC', name: 'Documenting', category: 'post-incident' },
  { id: 'ST-CLOSED', name: 'Closed', category: 'closed' },
  { id: 'ST-MERGED', name: 'Merged', category: 'merged' },
  { id: 'ST-CANCELED', name: 'Canceled', category: 'canceled' },
];
const ROLES = [
  { id: 'ROLE-LEAD', name: 'Incident Lead' },
  { id: 'ROLE-SCRIBE', name: 'Scribe' },
];
const status = (name) => ({ ...STATUSES.find((s) => s.name === name) });
const severity = (name) => {
  const s = SEVERITIES.find((x) => x.name === name);
  return s && { id: s.id, name: s.name };
};
const TEAMS = [
  { id: 'TEAM-PLATFORM', name: 'Platform' },
  { id: 'TEAM-SEARCH', name: 'Search' },
];
const lead = (user, id) => ({ role: 'Incident Lead', role_id: 'ROLE-LEAD', user, user_id: id });

function incident(n, name, st, sev, minutes, extra = {}) {
  return {
    id: `01FAKE${String(n).padStart(6, '0')}`,
    external_id: n,
    reference: `INC-${n}`,
    name,
    status: status(st),
    severity: severity(sev),
    incident_type: { id: 'TYPE-INT', name: 'Internal incident' },
    mode: 'standard',
    visibility: 'public',
    created_at: ago(minutes),
    reported_at: ago(minutes),
    updated_at: ago(Math.max(1, Math.round(minutes / 3))),
    permalink: `${ORG}/incidents/${n}`,
    chat_channel_platform: 'slack',
    chat_channel_url: `https://slack.example/app_redirect?channel=C${n}`,
    slack_channel_deep_link: `slack://channel?team=T1&id=C${n}`,
    call_url: `https://meet.example/inc-${n}`,
    summary: '',
    roles: [],
    participants: [],
    alerts: [],
    updates: [],
    team: 'TEAM-PLATFORM',
    ...extra,
  };
}

const incidents = [
  incident(412, 'Pods in CrashLoopBackOff in checkout-7c9d8b6f5', 'Triage', null, 6, {
    summary: 'Pods of the checkout ReplicaSet have been in CrashLoopBackOff for more than 5 minutes.',
    alerts: [{ id: 'AL-3', status: 'firing', title: 'KubePodCrashLooping' }],
  }),
  incident(411, 'checkout-7c9d8b6f5-x2k9p stuck in CrashLoopBackOff', 'Triage', null, 14, {
    summary: 'A checkout pod restarts in a loop after the 14:02 rollout.',
    alerts: [{ id: 'AL-2', status: 'firing', title: 'KubePodCrashLooping' }],
  }),
  incident(409, 'checkout pods CrashLoopBackOff after rollout', 'Investigating', 'High', 38, {
    summary:
      'Checkout pods crash at start since the 14:02 rollout: the new image reads a config key that is missing in production.\n\n- **Impact:** about a third of payments fail.\n- **Next:** roll back to the previous image.',
    roles: [lead('Grace Hopper', 'U-GRACE')],
    participants: ['Grace Hopper', 'Linus Torvalds', 'Ada Lovelace'],
