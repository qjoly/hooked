				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export PATH="/run/current-system/sw/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
PORT="${HOOKED_PORT:-4123}"
SEL="$(cat)"
if [ -z "$SEL" ]; then
  osascript -e "display notification \"No text selected\" with title \"Start hooked session (cite)\""
  exit 0
fi
PANEL="$HOME/bin/hooked-prompt-panel"
if [ -x "$PANEL" ]; then
  INSTR="$(printf '%s' "$SEL" | "$PANEL" 2&gt;/dev/null)"
  RC=$?
else
  INSTR="$(osascript -e 'try' -e 'display dialog "Instruction about the cited text:" default answer "" with title "Start hooked session (cite)" buttons {"Cancel", "Start"} default button "Start"' -e 'return text returned of result' -e 'on error number -128' -e 'return "__HOOKED_CANCEL__"' -e 'end try')"
  RC=$?
  if [ "$INSTR" = "__HOOKED_CANCEL__" ]; then RC=1; fi
fi
if [ "$RC" -ne 0 ]; then
  exit 0
fi
CITE="$(printf '%s\n' "$SEL" | sed 's/^/&gt; /')"
PROMPT="$(printf '%s\n\n%s\n' "$CITE" "$INSTR")"
BODY="$(printf '%s' "$PROMPT" | jq -Rs '{prompt: .}')"
RESP="$(curl -s -m 10 -X POST "http://localhost:${PORT}/api/launch" -H 'Content-Type: application/json' --data "$BODY")"
if [ -z "$RESP" ]; then
  osascript -e "display notification \"hooked unreachable on :${PORT}\" with title \"Start hooked session (cite)\""
  exit 1
fi
OK="$(printf '%s' "$RESP" | jq -r '.ok // false')"
if [ "$OK" != "true" ]; then
  ERR="$(printf '%s' "$RESP" | jq -r '.error // "launch failed"')"
  osascript -e "display notification \"${ERR}\" with title \"Start hooked session (cite)\""
  exit 1
fi
CWD="$(printf '%s' "$RESP" | jq -r '.cwd // ""')"
osascript -e "display notification \"Session started in ${CWD}\" with title \"hooked\""
open "http://localhost:${PORT}/"</string>
					<key>CheckedForUserDefaultShell</key>
