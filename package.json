{
  "name": "hooked",
  "version": "2.0.0",
  "private": true,
  "description": "Dashboard local pour suivre tes sessions Claude Code (live + stats)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "live": "vite dev --port 4123 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "start": "HOST=${HOST:-127.0.0.1} BODY_SIZE_LIMIT=${BODY_SIZE_LIMIT:-21M} node build",
    "setup": "node install.cjs",
    "prepare": "svelte-kit sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-node-pty.cjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "playwright-core": "^1.64.0",
    "svelte": "^5.1.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@pierre/diffs": "^1.2.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1",
    "node-pty": "^1.1.0"
  }
}
