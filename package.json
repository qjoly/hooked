{
  "name": "hooked",
  "version": "2.0.0",
  "private": true,
  "description": "Dashboard local pour suivre tes sessions Claude Code (live + stats)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "live": "vite dev --port 4123 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "start": "HOST=${HOST:-127.0.0.1} BODY_SIZE_LIMIT=${BODY_SIZE_LIMIT:-21M} node build",
    "setup": "node install.cjs",
    "prepare": "svelte-kit sync",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "svelte": "^5.1.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@pierre/diffs": "^1.2.12",
    "diff": "^7.0.0",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0"
  }
}
